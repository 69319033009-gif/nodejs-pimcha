      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .section-title span {
      color: var(--amber-dark);
    }

    .info-card {
      border: 1px solid #eee8dc;
      background: #fff;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .info-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 1rem 2rem rgba(60, 44, 13, .08);
    }

    .icon-badge {
      width: 48px;
      height: 48px;
      background: var(--gold-light);
      color: var(--amber-dark);
      border: 1px solid #f3dfaa;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
